# Database
DATABASE_URL=postgresql://paperforge:paperforge@localhost:5432/paperforge?connection_limit=5

# Redis
REDIS_URL=redis://localhost:6379
# Alternative host/port form when a full URL is not available.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# If true, rate-limited endpoints fail closed when Redis is unavailable.
# Leave false for local/dev and Vercel deployments without Redis; an in-memory fallback is used.
RATE_LIMIT_STRICT=false

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=paperforge
MINIO_SECRET_KEY=paperforge123
MINIO_BUCKET=paperforge
# When true, file operations fall back to DB / local FS if MinIO is unavailable
# (used by Vercel deploys without object storage). Set false to require MinIO.
MINIO_ALLOW_FALLBACK=true
# Optional local-disk path for the file fallback. Defaults to <cwd>/.local-storage.
LOCAL_STORAGE_PATH=

# Auth
# Auth.js v5 prefers AUTH_SECRET. NEXTAUTH_SECRET is kept as a legacy alias.
AUTH_SECRET=change-me-to-random-secret-at-least-32-chars
NEXTAUTH_SECRET=change-me-to-random-secret-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# OAuth (optional)
# Preferred Auth.js names. Legacy GOOGLE_CLIENT_ID/GITHUB_CLIENT_ID are also supported.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@paperforge.dev
# Force TLS for SMTP. Auto-enabled when SMTP_PORT=465 even if false.
SMTP_SECURE=false

# Encryption
ENCRYPTION_KEY=change-me-to-64-hex-chars-representing-32-bytes

# MinIO SSL (set to true for production with HTTPS)
MINIO_USE_SSL=false

# WebSocket (consumed by the websocket/ service)
WS_PORT=4001
# Disconnect idle sockets after N ms (default 30 minutes). Lower for tighter cleanup.
WS_IDLE_TIMEOUT_MS=1800000

# Worker (consumed by the worker/ service)
# Max retry attempts before a compilation job is marked failed.
WORKER_MAX_ATTEMPTS=3
# How long BullMQ holds the per-job lock while compilation runs.
WORKER_LOCK_DURATION_MS=180000

# Git repository storage path
GIT_REPOS_PATH=/tmp/paperforge-repos

# AI Assistant (optional — powers the AI LaTeX assistant panel)
ANTHROPIC_API_KEY=

# Billing (optional hosted checkout; leave empty for sales-assisted checkout)
BILLING_PROVIDER=manual
BILLING_CONTACT_EMAIL=sales@paperforge.dev
BILLING_CHECKOUT_PRO_MONTHLY_URL=
BILLING_CHECKOUT_PRO_ANNUAL_URL=
BILLING_CHECKOUT_TEAM_MONTHLY_URL=
BILLING_CHECKOUT_TEAM_ANNUAL_URL=
# Payment-provider webhook signing secret. Leave empty to disable the webhook
# endpoint (it returns 503 until set). Set to your provider's endpoint secret to
# enable automated plan provisioning via POST /api/v1/billing/webhook.
BILLING_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Surfaced in /api/healthz as the running build version. Falls back to package.json version.
NEXT_PUBLIC_APP_VERSION=

# WebSocket collaboration URL (leave EMPTY or omit on Vercel — editor runs in single-user mode)
# Only set this if you have a dedicated WebSocket server running.
NEXT_PUBLIC_WS_URL=ws://localhost:4001

# CORS — comma-separated list of additional origins allowed to call the API.
# NEXT_PUBLIC_APP_URL and NEXTAUTH_URL are added automatically; only set this for extras.
CORS_ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# Self-hosting
# ─────────────────────────────────────────────────────────────────────────────
# Deployment mode: `saas` (default) or `selfhost`.
# In selfhost mode the SaaS feature flags below default to false and the
# compilation backend defaults to `local`, so a private instance is safe
# without listing every variable. Gating is enforced server-side, not just
# hidden in the UI. Login, project roles, rate limits and quotas stay active
# in every mode.
PAPERFORGE_MODE=saas

# Feature gates. Defaults follow PAPERFORGE_MODE; set explicitly to override.
ENABLE_INTERNAL_AI=
ENABLE_PUBLIC_SIGNUP=
ENABLE_PUBLIC_SHARING=
ENABLE_BILLING=
ENABLE_GROWTH_ANALYTICS=
ENABLE_REMOTE_GIT_IMPORT=
# PR-0 guard: external live writes (changeset apply/revert via API) stay closed
# until the unified mutation core + versioned editor protocol are proven. Off by
# default; flip to true only once your install runs the new editor on all clients.
ENABLE_EXTERNAL_APPLY=false

# Editor collaboration sync mode. `versioned` (default) keeps Yjs read-only and
# saves through conditional HTTP PUTs (SHA-256 baseline); `yjs` restores the
# legacy Yjs write channel for deployments that explicitly opt out of the
# versioned protocol (consumed by the websocket/ service).
EDITOR_SYNC_MODE=versioned

# Compilation. `local` forbids the third-party LaTeX API outright: if the local
# queue is unreachable the job is persisted as pending_dispatch and reported as
# such, rather than uploading the manuscript to an external service.
COMPILATION_BACKEND=
ALLOW_REMOTE_COMPILE=
# Global compile concurrency. Start at 1 and raise only after measuring.
COMPILE_CONCURRENCY=1
# Optional digest over the pinned TeX image, fonts and build flags. Leave unset
# until the worker runtime is reproducible; an unset value disables build-cache identity.
TEX_RUNTIME_FINGERPRINT=
# The selected TeX image ID (sha256:...) must equal TEX_RUNTIME_FINGERPRINT
# in isolated staging. The worker refuses a mismatch.
TEX_IMAGE_DIGEST=
# Internal-only compile runner address; never expose it on a public port.
RUNNER_URL=
# Shared attempt data path inside the worker container.
COMPILE_DATA_PATH=
