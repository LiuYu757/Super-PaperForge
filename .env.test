# Real-database acceptance test configuration (PR-0 baseline, hardened in PR-A).
#
# Imported by tests/helpers/test-infra.ts via dotenv. The destructive harness
# reads TEST_DATABASE_URL ONLY — it never falls back to DATABASE_URL, so a
# shell (or container) that exports a production DATABASE_URL cannot make the
# acceptance suite connect to it, let alone truncate it. test-infra.ts also
# pins process.env.DATABASE_URL to TEST_DATABASE_URL at import time so the
# application's Prisma client and the helpers can never diverge.
#
# Run the suite with:
#   ./scripts/test-env.sh up
#   ./scripts/test-env.sh migrate   # also plants the test-instance marker
#   RUN_DESTRUCTIVE_TESTS=1 npm run test:integration
TEST_DATABASE_URL=postgresql://paperforge:paperforge-test-password@localhost:5433/paperforge_test?connection_limit=5
# Kept for tooling that still reads DATABASE_URL (e.g. prisma CLI); test-infra
# always overwrites it with TEST_DATABASE_URL while tests run.
DATABASE_URL=postgresql://paperforge:paperforge-test-password@localhost:5433/paperforge_test?connection_limit=5
REDIS_URL=redis://localhost:6380
TEST_REDIS_URL=redis://localhost:6380
MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_ACCESS_KEY=paperforge
MINIO_SECRET_KEY=paperforge-test-password
MINIO_BUCKET=paperforge
TEST_MINIO_ENDPOINT=localhost
TEST_MINIO_PORT=9010
TEST_MINIO_ACCESS_KEY=paperforge
TEST_MINIO_SECRET_KEY=paperforge-test-password
TEST_MINIO_BUCKET=paperforge-test
MINIO_USE_SSL=false
# Text source of truth is PostgreSQL in PR-1; the test env keeps the local FS
# fallback disabled so a MinIO breakage surfaces as a failure rather than a
# silent local-file read.
MINIO_ALLOW_FALLBACK=false
# Feature gates: the live-apply gate must be OFF in the acceptance baseline
# until PR-C~E close the remaining data-path findings.
ENABLE_EXTERNAL_APPLY=false
ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
NEXTAUTH_SECRET=test-secret-at-least-32-characters-long---
